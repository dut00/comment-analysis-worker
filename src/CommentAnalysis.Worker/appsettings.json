{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Host": {
    "ShutdownTimeout": "00:00:20"
  },
  "Consumer": {
    "Concurrency": 1,
    "Prefetch": 4,
    "MaxMessageBytes": 65536,
    "MaxContentLength": 10000,
    "MaxRetries": 3,
    "RetryDelay": "00:00:01"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollInterval": "00:00:01",
    "PublishTimeout": "00:00:10",
    "Retention": "7.00:00:00",
    "CleanupInterval": "01:00:00"
  },
  "DecisionPolicy": {
    "ApproveThreshold": 0.85,
    "RejectThreshold": 0.90
  }
}
